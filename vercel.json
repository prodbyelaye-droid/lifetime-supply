{
  "functions": {
    "api/landing.js": {
      "includeFiles": "index.html"
    }
  },
  "routes": [
    {
      "src": "^/favicon\\.ico$",
      "dest": "/brand/current/favicon.ico"
    },
    {
      "src": "^/apple-touch-icon\\.png$",
      "dest": "/brand/current/apple-touch-icon.png"
    },
    {
      "src": "^/assets/launch/lifetime-share-1106\\.jpg$",
      "dest": "/brand/current/og/lifetime-share-1106.jpg"
    },
    {
      "src": "^/$",
      "dest": "/api/landing"
    },
    {
      "src": "^/index\\.html$",
      "dest": "/api/landing"
    },
    {
      "handle": "filesystem"
    }
  ]
}
